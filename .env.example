# ----------------------------------------
# Application Environment
# ----------------------------------------
# Environment: development, staging, production
NODE_ENV=development

# ----------------------------------------
# Backend API Server Configuration
# ----------------------------------------
API_PORT=3000
API_HOST=0.0.0.0

# ----------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://astral_hub_user:astral_hub_password@localhost:5678/astral_hub"

# ----------------------------------------
# Cache Configuration (Redis)
# ----------------------------------------
# Format: redis://HOST:PORT
REDIS_URL="redis://localhost:6379"

# ----------------------------------------
# Authentication (JWT)
# ----------------------------------------
# Use a long, random string for JWT_SECRET in production
JWT_SECRET="your-super-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ----------------------------------------
# Frontend URLs
# ----------------------------------------
# For CORS configuration and other integrations
BUYER_WEB_URL="http://localhost:3001"
ADMIN_WEB_URL="http://localhost:3002"
POS_WEB_URL="http://localhost:3003"

# ----------------------------------------
# Google Cloud Platform
# ----------------------------------------
GCS_PROJECT_ID=""
GCS_BUCKET_NAME=""
GCS_KEY_FILE="./gcs-key.json"

# ----------------------------------------
# OAuth (Buyer Login)
# ----------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ----------------------------------------
# Payment - ECPay (綠界)
# ----------------------------------------
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
ECPAY_API_URL="https://payment-stage.ecpay.com.tw"
# ECPAY_API_URL="https://payment.ecpay.com.tw"  # 正式環境

# ----------------------------------------
# Logistics (物流)
# ----------------------------------------
# 7-11 賣貨便
SEVEN_ELEVEN_API_KEY=""

# 全家店到店
FAMILY_MART_API_KEY=""

# ----------------------------------------
# Email (SMTP)
# ----------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ----------------------------------------
# Monitoring & Logging
# ----------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info"
