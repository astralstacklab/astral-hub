# 環境
NODE_ENV=development

# ========================================
# API Server
# ========================================
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000

# ========================================
# 資料庫
# ========================================
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/card_erp

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ========================================
# Google Cloud Platform
# ========================================
GCP_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=card-erp-storage
GCS_KEY_FILE=./gcs-key.json

# ========================================
# JWT
# ========================================
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ========================================
# OAuth（買家登入）
# ========================================
# Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Facebook OAuth
FACEBOOK_APP_ID=xxx
FACEBOOK_APP_SECRET=xxx

# ========================================
# 金流服務
# ========================================
# 綠界 ECPay
ECPAY_MERCHANT_ID=your_merchant_id
ECPAY_HASH_KEY=your_hash_key
ECPAY_HASH_IV=your_hash_iv
ECPAY_API_URL=https://payment-stage.ecpay.com.tw  # 測試環境
# ECPAY_API_URL=https://payment.ecpay.com.tw      # 正式環境

# ========================================
# 物流服務
# ========================================
# 7-11 賣貨便
SEVEN_ELEVEN_API_KEY=xxx
SEVEN_ELEVEN_API_URL=https://api.7-11.com.tw

# 全家店到店
FAMILY_MART_API_KEY=xxx
FAMILY_MART_API_URL=https://api.family.com.tw

# ========================================
# 前端 URLs
# ========================================
BUYER_WEB_URL=http://localhost:3001
ADMIN_WEB_URL=http://localhost:3002
POS_WEB_URL=http://localhost:3003

# ========================================
# Email（未來功能）
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ========================================
# 其他
# ========================================
# Sentry（錯誤追蹤）
SENTRY_DSN=

# 日誌等級
LOG_LEVEL=info  # debug | info | warn | error
