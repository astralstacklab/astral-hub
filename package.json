{
  "name": "astral-hub",
  "version": "0.1.0",
  "description": "OMO 收藏卡交易平台 - 線上線下整合系統",
  "private": true,
  "author": "Astral Hub Team",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "echo 'Please run dev command in specific workspace (e.g., pnpm --filter api dev)'",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,vue}\"",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "setup-dev": "bash scripts/setup-dev.sh",
    "teardown-dev": "bash scripts/teardown-dev.sh",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:psql": "docker exec -it astral-hub-postgres psql -U astral_hub_user -d astral_hub",
    "validate-env": "tsx scripts/validate-env.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "dotenv": "^16.6.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "picocolors": "^1.1.1",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.2.0",
    "vue-eslint-parser": "^9.4.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
